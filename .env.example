# Copy this file to .env and fill only the keys you use.
# Never commit .env or real API keys. Do not put keys in config.yaml.
# Current application: free OpenRouter models only.
OPENROUTER_API_KEY=

# Provider-specific key loading is supported. Native generation adapters are
# not implemented yet (see docs/llm-providers-spec.ru.md).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Configure named profiles in config.yaml; saved llm_preferences can select one.
# GUI/CLI selectors and native/paid generation are planned next.
# Key presence must not enable paid use.
